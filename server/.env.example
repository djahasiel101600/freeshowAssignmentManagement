# Receiver (server) configuration for Docker.
# Copy this file to server/.env and fill in real values (never commit .env).
# app.py's _load_env() reads this file; real environment variables set by
# docker-compose always take precedence (they use setdefault).

# Token the FreeShow bridge must send via X-Bridge-Token.
# Must match BRIDGE_TOKEN in bridge/.env.
# Generate one with:  openssl rand -hex 32
BRIDGE_TOKEN=change-me-openssl-rand-hex-32

# Token the web app must send via X-App-Token for variable-edit commands
# and for /semaphore + /webhook proxying. Strongly recommended when public.
# Generate one with:  openssl rand -hex 32
APP_TOKEN=change-me-openssl-rand-hex-32

# Upstream targets for the reverse proxies (parity with the old Vite proxies)
SEMAPHORE_TARGET=https://api.semaphore.co/api/v4
WEBHOOK_TARGET=https://n8n.jdp-homelab.space
WEBHOOK_PATH_PREFIX=/webhook/a94af661-17a6-43a7-8540-21f510d19946

# Where snapshots/commands are persisted (mounted volume in Docker)
DATA_DIR=/app/data

# Bind address for uvicorn inside the container (do not change)
HOST=0.0.0.0
PORT=8000

# LOG_LEVEL=INFO
