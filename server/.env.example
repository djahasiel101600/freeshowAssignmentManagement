# Receiver (server) configuration for Docker.
# Copy this file to server/.env and fill in real values (never commit .env).
# app.py's _load_env() reads this file; real environment variables set by
# docker-compose always take precedence (they use setdefault).

# Token the FreeShow bridge must send via X-Bridge-Token.
# Must match BRIDGE_TOKEN in bridge/.env.
# Generate one with:  openssl rand -hex 32
BRIDGE_TOKEN=change-me-openssl-rand-hex-32

# Token the web app must send via X-App-Token for variable-edit commands
# and for /semaphore + /webhook proxying. Strongly recommended when public.
# Generate one with:  openssl rand -hex 32
APP_TOKEN=change-me-openssl-rand-hex-32

# Upstream targets for the reverse proxies (parity with the old Vite proxies)
SEMAPHORE_TARGET=https://api.semaphore.co/api/v4
WEBHOOK_TARGET=https://n8n.jdp-homelab.space
WEBHOOK_PATH_PREFIX=/webhook/a94af661-17a6-43a7-8540-21f510d19946

# Where snapshots/commands are persisted (mounted volume in Docker)
DATA_DIR=/app/data

# --- Accounts / sessions (database-backed login) ---------------------------
# First-run admin. If ADMIN_PASSWORD is empty a random one is generated and
# printed once in the container log; sign in and change it immediately.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password
# Set ADMIN_PASSWORD_RESET=true for exactly one restart to force that password
# back onto the admin account (e.g. after forgetting it).
# ADMIN_PASSWORD_RESET=false

# Sessions are HttpOnly cookies. Set SESSION_COOKIE_SECURE=true when the app is
# only ever reached over HTTPS (recommended behind the Cloudflare tunnel).
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=720

# --- Assignment ledger -----------------------------------------------------
# Calendar timezone used to decide which day an assignment belongs to.
SCHEDULE_TZ=Asia/Manila

# Optional: point at PostgreSQL instead of the bundled SQLite file.
# DATABASE_URL=postgresql+psycopg://user:pass@db:5432/freeshow

# Bind address for uvicorn inside the container (do not change)
HOST=0.0.0.0
PORT=8000

# LOG_LEVEL=INFO
