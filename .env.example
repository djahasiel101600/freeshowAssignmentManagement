# Compose-level variables. Docker Compose auto-loads this file (it must be
# copied to a local `.env`, which is git-ignored) — so plain
# `docker compose up -d --build` just works, and you override the public port
# / shared network without editing YAML or the Dockerfiles.

# Host port the frontend (nginx) listens on.
# 80   -> point cloudflared at http://127.0.0.1:80
# 8080 -> use this if 80 is already taken on the host
FRONTEND_PORT=80

# Network mode:
#  false (default) -> Compose creates an isolated network (freeshow-sms-internal)
#  true            -> attach BOTH services to an EXISTING network named by
#                     JDP_NETWORK_NAME (e.g. your homelab "jdp-network")
JDP_NETWORK_EXTERNAL=false
JDP_NETWORK_NAME=freeshow-sms-internal
