# Compose-level variables. Docker Compose auto-loads this file (it must be
# copied to a local `.env`, which is git-ignored) — so plain
# `docker compose up -d --build` just works, and you override the public port
# / shared network without editing YAML or the Dockerfiles.

# Host port the frontend (nginx) listens on.
# 80   -> point cloudflared at http://127.0.0.1:80
# 8080 -> use this if 80 is already taken on the host
FRONTEND_PORT=80

# Network: attach to your shared homelab network instead of letting Compose
# create a throwaway one. This is pre-set for a host that already runs
# `jdp-network` (shared with cloudflared + your other projects), so that:
#   - cloudflared (also on jdp-network) can reach the frontend as
#     freeshow-frontend:80
#   - NO extra/throwaway network is created (everything stays on jdp-network)
# Override to JDP_NETWORK_EXTERNAL=false to use an auto-created isolated network.
JDP_NETWORK_EXTERNAL=true
JDP_NETWORK_NAME=jdp-network
