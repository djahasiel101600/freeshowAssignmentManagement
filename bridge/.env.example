# Bridge configuration - copy to .env and fill in.
# CLI flags always win over this file.

# REQUIRED: base URL of the deployed receiver (the public cloudflared URL)
SERVER_URL=https://your-app.example.com

# Shared secret; must match BRIDGE_TOKEN in the server's .env
# Generate one with:  openssl rand -hex 32
BRIDGE_TOKEN=

# FreeShow endpoints on this machine
FREESHOW_HTTP_URL=http://localhost:5505
FREESHOW_WS_URL=ws://localhost:5505

# Transport FreeShow's WebSocket speaks: websocket | socketio | none
# If plain websocket keeps failing to handshake, try socketio.
WS_TRANSPORT=websocket

# Apply variable edits made in the web app back to FreeShow
ENABLE_COMMANDS=true

# Timing (seconds / milliseconds)
POLL_SECONDS=5
COMMAND_POLL_SECONDS=3
DEBOUNCE_MS=500
HEARTBEAT_SECONDS=60

# LOG_LEVEL=INFO