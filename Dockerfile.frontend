# syntax=docker/dockerfile-base:1.4
# Frontend service: build the Vite/React SPA, then serve it with nginx.
# Context is the repo root (needed for package.json, src/, vite.config.ts, ...).

FROM node:20-alpine AS builder
WORKDIR /app

# Install dependencies first so the layer is cached when only source changes.
COPY package.json package-lock.json ./
RUN npm ci

# Build the app (tsc -b && vite build -> ./dist)
COPY . .
RUN npm run build

# Serve with nginx (SPA fallback + /api passthrough to the backend service).
# Fully-qualified image so the Dockerfile works on Docker AND rootless podman.
FROM docker.io/library/nginx:stable-alpine AS runtime

# Replace the default config with our SPA + proxy config.
COPY nginx.conf /etc/nginx/conf.d/default.conf
# Built static site.
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80
